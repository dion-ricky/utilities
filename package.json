{
  "name": "dev-swiss-army-knife",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A static, backend-free developer utilities site. Every tool runs 100% in the browser.",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "gen:tool": "node scripts/gen-tool.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.52.0",
    "cron-parser": "^5.10.1",
    "cronstrue": "^3.29.0",
    "diff": "^9.0.0",
    "js-yaml": "^5.4.3",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "sql-formatter": "^15.9.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
